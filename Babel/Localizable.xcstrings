    "Deutsch": {},
    "Die Anmeldung läuft direkt auf fanfiction.net. Danach holt Babel deine Favoriten und Follows automatisch in die Bibliothek. Babel speichert kein Passwort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You log in directly on fanfiction.net. Babel then brings your favorites and follows into your library automatically. Babel never stores your password."
          }
        }
      }
    },
    "Die Seite hat zu lange gebraucht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The site took too long to respond."
          }
        }
      }
    },
    "Die Seite konnte nicht gelesen werden (%@). Vielleicht hat sich ihr Aufbau geändert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page couldn't be read (%@). Its layout may have changed."

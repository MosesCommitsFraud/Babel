    "„%@“ auf AO3 suchen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search AO3 for \"%@\""
          }
        }
      }
    },
    "„%@“ auf FanFiction.net suchen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search FanFiction.net for \"%@\""
          }
        }
      }
    },
    "„%@“ in der Bibliothek": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is in your library"
          }
        }
      }
    },
    "„%@“ löschen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”?"
          }
        }
      }
    },
    "„%@“ offline gespeichert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" saved offline"
          }
        }
      }
    },
    "„Als Paar“ zeigt nur Geschichten, in denen die beiden ein Pairing sind. Jedes Paar lässt sich einzeln einschalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"As a Pair\" only shows stories where the two are a pairing. Each pair can be switched on separately."
          }
        }
      }
    },
    "„Verlauf löschen“ entfernt Geschichten, die du nur angesehen, aber nicht in die Bibliothek gelegt hast.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Clear History\" removes stories you only viewed but didn't add to your library."
          }
        }
      }
    },

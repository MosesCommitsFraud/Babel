        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When logged in, you'll see your bookmarks, Marked for Later, subscriptions and history here and can add them to your library. Babel never stores your password – you log in directly on archiveofourown.org."
          }
        }
      }
    },

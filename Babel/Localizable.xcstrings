        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logging in is optional. It lets you bring bookmarks, Marked for Later and subscriptions from AO3, or favorites and follows from FanFiction.net into the app (AO3 and FanFiction tab → Account). Babel never stores passwords."
          }

    "Deutsch" : {},
    "Die Anmeldung läuft direkt auf fanfiction.net. Danach holt Babel deine Favoriten und Follows automatisch in die Bibliothek. Babel speichert kein Passwort." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You log in directly on fanfiction.net. Babel then brings your favorites and follows into your library automatically. Babel never stores your password."
          }
        }
      }
    },
    "Die Geschichte verschwindet aus Bibliothek und Verlauf, Lesestelle und Offline-Kapitel gehen verloren." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The story will be removed from your library and history; your reading position and offline chapters will be lost."
          }

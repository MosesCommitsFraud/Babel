    "%@ %@. Das liegt an der Seite, nicht an Babel – versuch es später nochmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. That's the site, not Babel – try again later."
          }
        }
      }
    },
    "%@ %@. Deshalb gibt es gerade keine Treffer – das liegt an der Seite, nicht an deiner Suche.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. That's why there are no results right now – it's the site, not your search."
          }
        }
      }
    },
    "%@ bremst gerade – weiter in %lld s": {
      "localizations": {

    },
    "Die Sicherheitsprüfung von FanFiction.net wurde nicht abgeschlossen. Versuch es nochmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FanFiction.net's security check wasn't completed. Please try again."
